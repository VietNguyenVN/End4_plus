// Generated by matugen from the wallpaper: the window border of niri, the same colours (and the same 1 px) as the border on Hyprland.
layout {
    border {
        width 1
        active-color "#{{colors.outline_variant.default.hex_stripped}}77"
        inactive-color "#{{colors.surface_container_low.default.hex_stripped}}33"
    }
}
