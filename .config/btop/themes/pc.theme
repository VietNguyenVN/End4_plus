# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1d1d20aa"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#78aeed"

# Background color of selected item in processes box
theme[selected_bg]="#303030"

# Foreground color of selected item in processes box
theme[selected_fg]="#78aeed"

# Color of inactive/disabled text
theme[inactive_fg]="#8c8c8c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f8e45c"

# Background color of the percentage meters
theme[meter_bg]="#303030"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f8e45c"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#78aeed"  # Accent color
theme[mem_box]="#8ff0a4"  # Success color
theme[net_box]="#78aeed"  # Accent color
theme[proc_box]="#78aeed" # Accent color

# Box divider line and small boxes line color
theme[div_line]="#8c8c8c"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8ff0a4"
theme[temp_mid]="#f8e45c"
theme[temp_end]="#ff7b63"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#78aeed"
theme[cpu_mid]="#78aeed"
theme[cpu_end]="#ffffff"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#78aeed"
theme[free_mid]="#78aeed"
theme[free_end]="#78aeed"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#78aeed"
theme[cached_mid]="#78aeed"
theme[cached_end]="#78aeed"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#f8e45c"
theme[available_mid]="#ff7b63"
theme[available_end]="#ff7b63"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#8ff0a4"
theme[used_mid]="#78aeed"
theme[used_end]="#78aeed"

# Download graph colors (Peach -> Red)
theme[download_start]="#f8e45c"
theme[download_mid]="#ff7b63"
theme[download_end]="#ff7b63"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#8ff0a4"
theme[upload_mid]="#78aeed"
theme[upload_end]="#78aeed"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#78aeed"
theme[process_mid]="#78aeed"
theme[process_end]="#78aeed"
